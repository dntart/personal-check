# Proyecto Supabase COMPARTIDO por todo el portfolio (mismo valor que en los
# otros SaaS, ej. alma) — PersonalCheck se aísla por schema (`personalcheck`),
# no por proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO server-side (invitar admins, altas de organización
# vía Super Admin). Nunca exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string de Postgres (Project Settings > Database > Connection
# string > "URI"). Solo se usa localmente para generar tipos TS
# (`npm run types:generate`) — nunca se despliega ni se expone al cliente.
SUPABASE_DB_URL=

# Resend — envío de invitaciones a admins/supervisores
RESEND_API_KEY=

# Proxy propio de IA compartido por el portfolio (si este SaaS lo usa)
AI_PROXY_URL=
AI_PROXY_KEY=
