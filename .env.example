# Proyecto Supabase COMPARTIDO por todo el portfolio (mismo valor que en los
# otros SaaS, ej. alma) — PersonalCheck se aísla por schema (`personalcheck`),
# no por proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO server-side (invitar admins, altas de organización
# vía Super Admin). Nunca exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de ESTE deploy (sin barra final) — se usa para armar el link
# de "creá tu contraseña" que reciben los admins/supervisores invitados.
# En Vercel: la URL de producción del proyecto. En local: dejar el default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para generar tipos TS localmente (`npm run types:generate`) — nunca
# se despliega ni se expone al cliente.
# SUPABASE_ACCESS_TOKEN: token personal de tu cuenta Supabase, generalo en
#   https://supabase.com/dashboard/account/tokens (uno solo sirve para
#   todos tus SaaS del portfolio, no es por proyecto).
# SUPABASE_PROJECT_ID: el project ref del proyecto compartido (se ve en la
#   URL del dashboard: supabase.com/dashboard/project/<ESTO>).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=

# Resend — alertas por email de saldo fuera de rango (spec sección 5,
# Fase 2). Las invitaciones de admins/supervisores van por el mailer propio
# de Supabase Auth, no por acá. Sin esta key, las alertas solo se loguean
# en consola (no rompe nada, pero tampoco mandan el email de verdad).
RESEND_API_KEY=
# Remitente verificado en Resend. Sin dominio propio verificado, dejar el
# default de pruebas (onboarding@resend.dev, solo entrega a tu propio email
# de cuenta de Resend).
RESEND_FROM_EMAIL=PersonalCheck <onboarding@resend.dev>

# Proxy propio de IA compartido por el portfolio (si este SaaS lo usa)
AI_PROXY_URL=
AI_PROXY_KEY=
