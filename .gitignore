# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example se commitea a propósito, sin valores reales)
.env*.local
.env

# vercel
.vercel

# caché temporal del CLI de Supabase (queda al correr `npm run types:generate`)
/supabase/.temp

# Seeds con datos reales de clientes (nombres reales de personas) — nunca
# van al repo, ni siquiera privado. Purgados del historial el 2026-09-15.
docs/seeds/

# typescript
*.tsbuildinfo
next-env.d.ts
